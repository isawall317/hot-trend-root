# 复制为 .env，填入实际 key
# 注意：.env 已被 .gitignore 忽略，不会进 git

# 智谱 GLM (https://open.bigmodel.cn/)
ZHIPU_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Moonshot / Kimi (https://platform.moonshot.cn/)
MOONSHOT_API_KEY=

# 阿里百炼 (https://bailian.console.aliyun.com/)
DASHSCOPE_API_KEY=

# 字节火山方舟 (https://www.volcengine.com/product/ark)
ARK_API_KEY=

# ----- 采集源 -----
# RSSHub 实例地址（默认本地 docker compose up 起的实例）
# 部署到 VPS 后改成 https://rsshub.your-domain.com
RSSHUB_BASE_URL=http://localhost:1200
