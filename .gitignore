.DS_Store
*.log
node_modules/
.next/
build/
__pycache__/
*.pyc
*.egg-info/
.env
.env.local
.venv/
config.yaml

# Hot Trend — 采集数据（不跟踪，数据量大且频繁变化）
data/raw/
data/archive/
# KB baseline 快照（每次 pipeline 跑都会变，属运行时状态）
aikb/database/.last-run/

# 编辑器/工具配置
.obsidian/
.zcode/
# 注：.claude/ 和 .omc/ 是项目交付物（SKILL 工作流 + 项目记忆），不忽略

# 外部工具源码（独立 clone 的仓库，不进主仓库）
reference/codingplan/
# 注：DailyHotApi / RSSHub 已迁至 quality-sources/services/（独立仓库）
# 注：reference/pricing-snapshots/ 不忽略，存厂商官网快照作为数据准确性证据
tools/collector/tools/

# 构建产物：只跟踪 latest 副本（*-saver.html 等无时间戳文件），忽略时间戳历史副本
# build.py 每次 build 会生成带时间戳的副本（本地调试用），这些是构建垃圾不进仓库
dist/*-2026-*.html
dist/*-2025-*.html
# launchd 定时采集日志
data/logs/

# Tencent Cloud EdgeOne
.edgeone/*
.tef_dist/*
  